// Rental Management System — data model
//
// Covers the five core modules from the problem statement:
//   1. Rental Operations Dashboard   -> derived from RentalOrder / Pickup / Return
//   2. Security Deposit Management   -> SecurityDeposit + DepositTransaction
//   3. Late Return Fee Management    -> LateFeeRule + LateFee
//   4. Pickup & Return Management    -> Pickup + Return + ReturnInspection
//   5. Price & Attributes            -> Pricelist + PricelistItem + Product variants

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection: serverless functions open many short-lived connections,
  // so a pooler (Neon/Supabase pgbouncer) is required in production.
  url       = env("DATABASE_URL")
  // Migrations need a direct, unpooled connection — poolers in transaction mode
  // can't run the DDL that `prisma migrate deploy` issues. Locally both point
  // at the same server.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Authentication & users
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  CUSTOMER
  VENDOR
}

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  phone            String?
  passwordHash     String
  role             Role      @default(CUSTOMER)
  imageUrl         String?
  /// Dashboard tiles this admin chose to show, in order, as a JSON array of
  /// widget keys. Null = the default set.
  dashboardWidgets String?
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  addresses      Address[]
  orders         RentalOrder[]
  quotations     Quotation[]
  cart           Cart?
  paymentMethods PaymentMethod[]
  notifications  Notification[]
  vendor         Vendor?

  @@index([role])
  @@map("users")
}

enum AddressType {
  SHIPPING
  BILLING
}

model Address {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       AddressType @default(SHIPPING)
  label      String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String      @default("India")
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  shippedOrders RentalOrder[]

  @@index([userId])
  @@map("addresses")
}

model PaymentMethod {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand       String
  last4       String
  expiryMonth Int
  expiryYear  Int
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("payment_methods")
}

// ---------------------------------------------------------------------------
// Catalogue — products, variants, attributes
// ---------------------------------------------------------------------------

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  description      String?
  sku              String    @unique
  imageUrl         String?
  categoryId       String?
  /// Supplier this stock was bought or leased from.
  vendorId         String?
  category         Category? @relation(fields: [categoryId], references: [id])
  isRentable       Boolean   @default(true)
  totalStock       Int       @default(0)
  reservedStock    Int       @default(0)
  /// Units withdrawn from service while a repair job is open. Availability is
  /// totalStock - reservedStock - underRepairStock.
  underRepairStock Int       @default(0)

  // Deposit defaults, overridable per pricelist / order.
  depositType  DepositType @default(FIXED)
  depositValue Decimal     @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants       ProductVariant[]
  pricelistItems PricelistItem[]
  orderLines     RentalOrderLine[]
  quotationLines QuotationLine[]
  cartItems      CartItem[]
  repairJobs     RepairJob[]
  trackers       AssetTracker[]
  vendor         Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@map("products")
}

/// Variant axes from the brief: Brand, Manufacturer, Color, Size.
model ProductVariant {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String  @unique
  brand        String?
  manufacturer String?
  color        String?
  size         String?
  stock        Int     @default(0)

  @@index([productId])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// Pricing — one default pricelist, plus optional time-bound pricelists
// ---------------------------------------------------------------------------

enum RentalUnit {
  HOUR
  DAY
  WEEK
  MONTH
}

model RentalPeriod {
  id        String     @id @default(cuid())
  name      String
  unit      RentalUnit
  duration  Int        @default(1)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  pricelistItems PricelistItem[]
  orderLines     RentalOrderLine[]
  quotationLines QuotationLine[]
  cartItems      CartItem[]

  @@unique([unit, duration])
  @@map("rental_periods")
}

model Pricelist {
  id        String    @id @default(cuid())
  name      String
  /// Exactly one pricelist should carry isDefault = true; it applies to all products.
  isDefault Boolean   @default(false)
  isActive  Boolean   @default(true)
  /// Time-bound pricelists (seasonal / promotional). Null = always applicable.
  validFrom DateTime?
  validTo   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  items PricelistItem[]

  @@map("pricelists")
}

model PricelistItem {
  id             String       @id @default(cuid())
  pricelistId    String
  pricelist      Pricelist    @relation(fields: [pricelistId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  rentalPeriodId String
  rentalPeriod   RentalPeriod @relation(fields: [rentalPeriodId], references: [id])
  price          Decimal      @db.Decimal(12, 2)

  @@unique([pricelistId, productId, rentalPeriodId])
  @@index([productId])
  @@map("pricelist_items")
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id             String       @id @default(cuid())
  cartId         String
  cart           Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  rentalPeriodId String
  rentalPeriod   RentalPeriod @relation(fields: [rentalPeriodId], references: [id])
  quantity       Int          @default(1)
  rentalStart    DateTime
  rentalEnd      DateTime

  @@index([cartId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// Quotations (admin creates these for walk-in / offline customers)
// ---------------------------------------------------------------------------

enum QuotationStatus {
  DRAFT
  SENT
  CONFIRMED
  CANCELLED
}

model QuotationTemplate {
  id                  String   @id @default(cuid())
  name                String
  header              String?
  footer              String?
  terms               String?
  isDefault           Boolean  @default(false)
  /// Share of the total the client pays up front to confirm the quotation.
  /// From the mockup's "Payment Terms ___ %".
  paymentTermsPercent Int      @default(100)
  /// How long the quotation stays valid, overriding the org default.
  validityDays        Int?
  createdAt           DateTime @default(now())

  quotations Quotation[]

  @@map("quotation_templates")
}

model Quotation {
  id           String             @id @default(cuid())
  number       String             @unique
  customerId   String
  customer     User               @relation(fields: [customerId], references: [id])
  templateId   String?
  template     QuotationTemplate? @relation(fields: [templateId], references: [id])
  status       QuotationStatus    @default(DRAFT)
  subtotal     Decimal            @default(0) @db.Decimal(12, 2)
  depositTotal Decimal            @default(0) @db.Decimal(12, 2)
  total        Decimal            @default(0) @db.Decimal(12, 2)
  validUntil   DateTime?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  lines QuotationLine[]
  order RentalOrder?

  @@index([customerId])
  @@map("quotations")
}

model QuotationLine {
  id             String       @id @default(cuid())
  quotationId    String
  quotation      Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  rentalPeriodId String
  rentalPeriod   RentalPeriod @relation(fields: [rentalPeriodId], references: [id])
  quantity       Int          @default(1)
  unitPrice      Decimal      @db.Decimal(12, 2)
  rentalStart    DateTime
  rentalEnd      DateTime
  lineTotal      Decimal      @db.Decimal(12, 2)

  @@index([quotationId])
  @@map("quotation_lines")
}

// ---------------------------------------------------------------------------
// Rental orders — the spine of the lifecycle
// ---------------------------------------------------------------------------

enum OrderStatus {
  DRAFT
  CONFIRMED
  READY_FOR_PICKUP
  PICKED_UP
  ACTIVE
  RETURN_DUE
  OVERDUE
  RETURNED
  COMPLETED
  CANCELLED
}

enum FulfilmentMethod {
  DELIVERY
  STORE_PICKUP
}

model RentalOrder {
  id          String           @id @default(cuid())
  number      String           @unique
  customerId  String
  customer    User             @relation(fields: [customerId], references: [id])
  quotationId String?          @unique
  quotation   Quotation?       @relation(fields: [quotationId], references: [id])
  status      OrderStatus      @default(DRAFT)
  fulfilment  FulfilmentMethod @default(DELIVERY)

  shippingAddressId String?
  shippingAddress   Address? @relation(fields: [shippingAddressId], references: [id])

  rentalStart DateTime
  rentalEnd   DateTime
  /// Set when the customer actually hands the goods back; drives late-fee maths.
  returnedAt  DateTime?

  subtotal     Decimal @default(0) @db.Decimal(12, 2)
  depositTotal Decimal @default(0) @db.Decimal(12, 2)
  lateFeeTotal Decimal @default(0) @db.Decimal(12, 2)
  total        Decimal @default(0) @db.Decimal(12, 2)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    RentalOrderLine[]
  payments Payment[]
  deposit  SecurityDeposit?
  lateFees LateFee[]
  pickup   Pickup?
  return   Return?
  invoices Invoice[]
  trackers AssetTracker[]

  @@index([customerId])
  @@index([status])
  @@index([rentalEnd])
  @@map("rental_orders")
}

model RentalOrderLine {
  id             String       @id @default(cuid())
  orderId        String
  order          RentalOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  rentalPeriodId String
  rentalPeriod   RentalPeriod @relation(fields: [rentalPeriodId], references: [id])
  quantity       Int          @default(1)
  unitPrice      Decimal      @db.Decimal(12, 2)
  depositAmount  Decimal      @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal      @db.Decimal(12, 2)

  @@index([orderId])
  @@map("rental_order_lines")
}

// ---------------------------------------------------------------------------
// Payments & invoices
// ---------------------------------------------------------------------------

enum PaymentPurpose {
  RENTAL
  DEPOSIT
  LATE_FEE
  REFUND
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id        String         @id @default(cuid())
  orderId   String
  order     RentalOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  purpose   PaymentPurpose
  status    PaymentStatus  @default(PENDING)
  amount    Decimal        @db.Decimal(12, 2)
  method    String?
  reference String?
  paidAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([orderId])
  @@map("payments")
}

enum InvoiceKind {
  RENTAL
  LATE_FEE
  DEPOSIT_REFUND
}

model Invoice {
  id       String      @id @default(cuid())
  number   String      @unique
  orderId  String
  order    RentalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind     InvoiceKind @default(RENTAL)
  amount   Decimal     @db.Decimal(12, 2)
  issuedAt DateTime    @default(now())
  pdfUrl   String?

  @@index([orderId])
  @@map("invoices")
}

// ---------------------------------------------------------------------------
// Module 2 — Security deposits
// ---------------------------------------------------------------------------

enum DepositType {
  FIXED
  PERCENTAGE
}

enum DepositStatus {
  PENDING
  COLLECTED
  HELD
  PARTIALLY_REFUNDED
  REFUNDED
  FORFEITED
}

model SecurityDeposit {
  id      String        @id @default(cuid())
  orderId String        @unique
  order   RentalOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type    DepositType   @default(FIXED)
  /// Configured value: an amount when FIXED, a percentage when PERCENTAGE.
  value   Decimal       @db.Decimal(12, 2)
  amount  Decimal       @db.Decimal(12, 2)
  status  DepositStatus @default(PENDING)

  deductedAmount Decimal   @default(0) @db.Decimal(12, 2)
  refundedAmount Decimal   @default(0) @db.Decimal(12, 2)
  collectedAt    DateTime?
  settledAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions DepositTransaction[]

  @@map("security_deposits")
}

enum DepositTxnType {
  COLLECTION
  DEDUCTION
  REFUND
}

/// Append-only ledger giving the "complete deposit history" the brief asks for.
model DepositTransaction {
  id        String          @id @default(cuid())
  depositId String
  deposit   SecurityDeposit @relation(fields: [depositId], references: [id], onDelete: Cascade)
  type      DepositTxnType
  amount    Decimal         @db.Decimal(12, 2)
  note      String?
  createdAt DateTime        @default(now())

  @@index([depositId])
  @@map("deposit_transactions")
}

// ---------------------------------------------------------------------------
// Module 3 — Late return fees
// ---------------------------------------------------------------------------

model LateFeeRule {
  id            String     @id @default(cuid())
  name          String
  /// Charge unit: fee accrues per hour / day / week / month overdue.
  unit          RentalUnit @default(DAY)
  amountPerUnit Decimal    @db.Decimal(12, 2)
  /// Overdue time inside the grace window is not charged.
  graceHours    Int        @default(0)
  /// Null = uncapped.
  maxAmount     Decimal?   @db.Decimal(12, 2)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())

  lateFees LateFee[]

  @@map("late_fee_rules")
}

enum LateFeeStatus {
  CALCULATED
  DEDUCTED_FROM_DEPOSIT
  INVOICED
  WAIVED
  PAID
}

model LateFee {
  id           String        @id @default(cuid())
  orderId      String
  order        RentalOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ruleId       String?
  rule         LateFeeRule?  @relation(fields: [ruleId], references: [id])
  overdueUnits Int           @default(0)
  amount       Decimal       @db.Decimal(12, 2)
  status       LateFeeStatus @default(CALCULATED)
  calculatedAt DateTime      @default(now())

  @@index([orderId])
  @@map("late_fees")
}

// ---------------------------------------------------------------------------
// Module 4 — Pickup & return
// ---------------------------------------------------------------------------

enum PickupStatus {
  SCHEDULED
  IN_TRANSIT
  COMPLETED
  MISSED
}

model Pickup {
  id            String       @id @default(cuid())
  orderId       String       @unique
  order         RentalOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  scheduledFor  DateTime
  status        PickupStatus @default(SCHEDULED)
  /// Position within the day's route, for sequence planning.
  routeSequence Int?
  assignedTo    String?
  barcode       String?
  checklist     Json?
  confirmedAt   DateTime?
  notes         String?

  @@index([scheduledFor])
  @@map("pickups")
}

enum ReturnStatus {
  SCHEDULED
  RECEIVED
  INSPECTED
  COMPLETED
  MISSED
}

enum ItemCondition {
  GOOD
  DAMAGED
  MISSING_ACCESSORIES
  UNUSABLE
}

model Return {
  id           String       @id @default(cuid())
  orderId      String       @unique
  order        RentalOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  scheduledFor DateTime
  receivedAt   DateTime?
  status       ReturnStatus @default(SCHEDULED)
  isLate       Boolean      @default(false)
  barcode      String?
  notes        String?

  inspections ReturnInspection[]

  @@index([scheduledFor])
  @@map("returns")
}

model ReturnInspection {
  id                 String        @id @default(cuid())
  returnId           String
  return             Return        @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId          String
  condition          ItemCondition @default(GOOD)
  damageNote         String?
  missingAccessories String?
  repairRequired     Boolean       @default(false)
  damageCharge       Decimal       @default(0) @db.Decimal(12, 2)
  inspectedAt        DateTime      @default(now())

  repairJob RepairJob?

  @@index([returnId])
  @@map("return_inspections")
}

enum RepairStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  WRITTEN_OFF
}

/// A unit out of service after a damaged return.
///
/// The brief asks for "repair workflow initiation when required": flagging an
/// inspection as damaged opens one of these automatically, which withdraws the
/// units from availability until the job is closed.
model RepairJob {
  id            String            @id @default(cuid())
  productId     String
  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  inspectionId  String?           @unique
  inspection    ReturnInspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  /// The rental that caused the damage, for traceability.
  orderNumber   String?
  status        RepairStatus      @default(PENDING)
  issue         String
  quantity      Int               @default(1)
  estimatedCost Decimal           @default(0) @db.Decimal(12, 2)
  actualCost    Decimal?          @db.Decimal(12, 2)
  assignedTo    String?
  /// External workshop handling the job, when it is not done in house.
  vendorId      String?
  notes         String?
  openedAt      DateTime          @default(now())
  startedAt     DateTime?
  completedAt   DateTime?

  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([status])
  @@map("repair_jobs")
}

// ---------------------------------------------------------------------------
// Organisation-wide rental configuration
// ---------------------------------------------------------------------------

enum NotificationKind {
  PICKUP_TOMORROW
  RETURN_DUE_SOON
  RETURN_OVERDUE
  DEPOSIT_REFUNDED
}

/// In-app reminders for customers.
///
/// The brief asks for customer notifications and automatic reminders. These
/// are written in-app rather than emailed so the feature works without an
/// email provider; `dedupeKey` makes the generator safe to run repeatedly.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  title     String
  body      String
  orderId   String?
  /// One notification per user, kind and subject per day.
  dedupeKey String           @unique
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

model OrgSettings {
  id                  String      @id @default("default")
  companyName         String      @default("RentFlow Rentals")
  currency            String      @default("INR")
  defaultDepositType  DepositType @default(FIXED)
  defaultDepositValue Decimal     @default(0) @db.Decimal(12, 2)
  defaultGraceHours   Int         @default(0)
  quotationValidDays  Int         @default(7)
  updatedAt           DateTime    @updatedAt

  @@map("org_settings")
}

// ---------------------------------------------------------------------------
// IoT asset tracking
//
// A tracker is a physical tag on one rentable unit. Devices POST telemetry to
// /api/iot/telemetry; the admin console reads the latest reading per tracker
// and flags any that have gone quiet. Nothing here assumes a particular vendor
// — anything that can make an HTTP request works.
// ---------------------------------------------------------------------------

enum TrackerStatus {
  IDLE
  OUT_ON_RENT
  IN_TRANSIT
  MISSING
}

model AssetTracker {
  id       String  @id @default(cuid())
  /// Printed on the tag; what the device sends to identify itself.
  deviceId String  @unique
  label    String?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Set while the unit is out with a customer.
  orderId String?
  order   RentalOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  status     TrackerStatus @default(IDLE)
  batteryPct Int?
  latitude   Float?
  longitude  Float?
  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pings TrackerPing[]

  @@index([productId])
  @@index([status])
  @@map("asset_trackers")
}

model TrackerPing {
  id        String       @id @default(cuid())
  trackerId String
  tracker   AssetTracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)

  batteryPct Int?
  latitude   Float?
  longitude  Float?
  recordedAt DateTime @default(now())

  @@index([trackerId, recordedAt])
  @@map("tracker_pings")
}

// ---------------------------------------------------------------------------
// Vendors (suppliers)
//
// Who the rental stock is bought or leased from, and who repairs it when a job
// goes outside. This is the procurement side only — it deliberately does not
// touch the customer money flow, which stays between the customer and the
// business (deposit held, penalty deducted, balance refunded).
// ---------------------------------------------------------------------------

model Vendor {
  id            String  @id @default(cuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  /// Tax registration, printed on purchase paperwork.
  gstin         String?

  addressLine String?
  city        String?
  state       String?
  postalCode  String?
  country     String  @default("India")

  /// Agreed settlement window for the supplier's invoices.
  paymentTermsDays Int     @default(30)
  notes            String?
  isActive         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Optional sign-in account, so a supplier can see their own stock and jobs.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  products   Product[]
  repairJobs RepairJob[]

  @@index([isActive])
  @@map("vendors")
}
