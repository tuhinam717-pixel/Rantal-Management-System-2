# ---------------------------------------------------------------------------
# Database (PostgreSQL). `docker compose up -d` starts one matching this URL.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://rental:rental@localhost:5432/rental_management?schema=public"

# ---------------------------------------------------------------------------
# Auth — HS256 secret used to sign the session JWT stored in an httpOnly cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-characters"
SESSION_MAX_AGE_DAYS="7"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="RentFlow"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
