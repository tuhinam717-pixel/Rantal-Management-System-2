# ---------------------------------------------------------------------------
# Database (PostgreSQL). `docker compose up -d` starts one matching this URL.
# ---------------------------------------------------------------------------
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://rental:rental@localhost:5432/rental_management?schema=public"
# Direct (unpooled) connection used by `prisma migrate`. Locally this is the
# same server; on Neon/Supabase it is the non-pooler host.
DIRECT_URL="postgresql://rental:rental@localhost:5432/rental_management?schema=public"

# ---------------------------------------------------------------------------
# Auth — HS256 secret used to sign the session JWT stored in an httpOnly cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-characters"
SESSION_MAX_AGE_DAYS="7"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="RentFlow"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local demos only. Renders one-click sign-in buttons with seeded credentials
# on the login page. Never enable this on a deployed build.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN="false"
